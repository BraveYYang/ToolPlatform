	SET_TEMPERATURE_FAN_SWITCH TEMPERATURE_FAN=chamber_fan VALUE=1

[gcode_macro PROBE_TEST]
gcode = 
	G1 X150 Y150
	{% for _ in range(200) %}
	G1 X140 Y140 F2000
	G1 X150 Y150 F2000
	PROBE_ACCURACY PROBE_SPEED=5 SAMPLES=1 SAMPLE_RETRACT_DIST=3
	{% endfor %}

[gcode_macro CHANGE_T_PARAM]
variable_current_num = 0
variable_nozzle_pos_x = 57
variable_nozzle_pos_y = 335
gcode = 

[gcode_macro UNINSTALL_NOZZLE]
gcode = 
	IF_NEED_HOME
	{% set uninstall_num = params.NUM|default(1)|int %}
	{% set temp_x_pos = printer['gcode_macro CHANGE_T_PARAM'].nozzle_pos_x + uninstall_num*48|default(1)|int %}
	{% set temp_y_pos = printer['gcode_macro CHANGE_T_PARAM'].nozzle_pos_y %}
	{action_respond_info("uninstall nozzle; num = %s, x_pos = %s" % (uninstall_num, temp_x_pos))}
	
	SET_LIMITS
	G1 Y{temp_y_pos - 60} F18000
	G1 X{temp_x_pos - 10} F18000
	G1 Y{temp_y_pos - 32} F3900
	G1 Y{temp_y_pos} F2000
	G1 X{temp_x_pos} F2000
	G1 Y{temp_y_pos - 32} F2000
	G1 X{temp_x_pos - 10} F2000
	G1 Y{temp_y_pos - 60} F2000
	RESTORE_LIMITS

[gcode_macro LOAD_NOZZLE]
gcode = 
	IF_NEED_HOME
	{% set load_num = params.NUM|default(1)|int %}
	{% set temp_x_pos = printer['gcode_macro CHANGE_T_PARAM'].nozzle_pos_x + load_num*48|default(1)|int %}
	{% set temp_y_pos = printer['gcode_macro CHANGE_T_PARAM'].nozzle_pos_y %}
	{action_respond_info("load nozzle; num = %s, x_pos = %s" % (load_num, temp_x_pos))}
	
	SET_LIMITS
	G1 Y{temp_y_pos - 60} F18000
	G1 X{temp_x_pos - 10} F18000
	G1 Y{temp_y_pos - 32} F2000
	G1 X{temp_x_pos} F2000
	G1 Y{temp_y_pos} F2000
	G1 X{temp_x_pos - 10} F2000
	G1 Y{temp_y_pos - 32} F2000
	G1 Y{temp_y_pos - 60} F2000
	RESTORE_LIMITS

[gcode_macro CHANGE_T]
gcode = 
	
	{% set target_temp = printer.extruder.target %}
	{% if target_temp > 180 %}
	M104 S{target_temp + 1}
	{% endif %}
	
	IF_NEED_HOME
	{% if printer.gcode_move.gcode_position.z < 5.0 %}
	G1 Z5 F600
	{% endif %}
	
	{% set load_num = params.NUM|default(1)|int %}
	UNINSTALL_NOZZLE NUM={printer['gcode_macro CHANGE_T_PARAM'].current_num}
	
	LOAD_NOZZLE NUM={load_num}
	SET_GCODE_VARIABLE MACRO=CHANGE_T_PARAM VARIABLE=current_num VALUE={load_num}
	
	MULIT_NOZZLE_OFFSET_SET NUM={load_num}
	
