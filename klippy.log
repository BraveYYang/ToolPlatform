[gcode_macro LOOP_XY_OFFSETCALC]
gcode = 
	
	{% set count = params.COUNT|default(1)|int %}
	{% set force = params.FORCE|default(1)|int %}
	{% set camera = params.CAMERA|default(0)|int %}
	{% set nozzles = params.NOZZLES|default("0,1,2,3") %}
	{% set mode = params.MODE|default(0)|int %}
	{% set line_mode = params.LINE_MODE|default(1)|int %}
	{% set temp = params.TEMP|default(0)|int %}
	{% set file_name = params.FILE_NAME|default("LOOP_XY") %}
	{% set cx = params.CX|default(24.3)|float %}
	{% set cy = params.CY|default(25)|float %}
	{% set cz = params.CZ|default(8.4)|float %}
	{% set camera_dir = params.CAMERA_DIR|default("/mnt/SDCARD/cxsw/printer_data/logs/camera_file") %}
	
	BED_MESH_CLEAR
	{% if mode == 0 %}
	ECS_XY_CALIBRATION SCAN=True
	{% for n in nozzles.split(",") %}
	{% set num = (n|trim)|int %}
	{% for i in range(count) %}
	ECS_XY_CALIBRATION NUM={num} FILE={file_name}
	NOZZLE_REPLACE NOZZLE={num} FORCE={force}
	SET_GCODE_OFFSET X=0 Y=0
	{% endfor %}
	{% endfor %}
	{% elif mode == 1 %}
	{% for i in range(count) %}
	M104 S{temp} T0
	M104 S{temp} T1
	M104 S{temp} T2
	M104 S{temp} T3
	XYZ_OFFSET_CALC MODE=2 CLEAN=1 LINE_MODE={line_mode} CAMERA=True CAMERA_POS={cx},{cy} CAMERA_Z_POS={cz} XYTEMP={temp} CAMERA_OUTPUT={camera_dir}/{file_name}_r{"%03d"|format(i + 1)}
	{% for n in nozzles.split(",") %}
	{% set num = (n|trim)|int %}
	T{num}
	BED_MESH_CLEAR
	{% if camera > 0 %}
	G4 P1000
	G1 Z{cz} F600
	G1 X{cx} Y{cy} F12000
	M400
	CAMERA_CAPTURE VIDEO=/dev/video{camera} OUTPUT={camera_dir}/{file_name}_r{"%03d"|format(i + 1)}/{file_name}_r{"%03d"|format(i + 1)}_n{num}.jpg
	{% endif %}
	{% endfor %}
	{% endfor %}
	{% elif mode == 2 %}
	{% for i in range(count) %}
	XYZ_OFFSET_CALC MODE=2 CLEAN=1 CAMERA=True CAMERA_POS={cx},{cy} CAMERA_Z_POS={cz} XYTEMP={temp} CAMERA_OUTPUT={camera_dir}/{file_name}_r{"%03d"|format(i + 1)}
	{% endfor %}
	{% endif %}

