[gcode_macro Qmode]
variable_flag = 0
variable_accel = 0
variable_accel_to_decel = 0
variable_velocity = 0
variable_square_corner_velocity = 0
variable_pressure_advance = 0.0
variable_fan0_value = 0.00
variable_fan1_value = 0.00
variable_fan2_value = 0.00
variable_speed_factor = 0
variable_max_accel = 2500
variable_max_accel_to_decel = 2500
gcode = 
	{% set printer_state = printer.print_stats.state %}
	{% if printer['gcode_macro Qmode'].flag|int == 0 %}
	{% if printer_state == "printing" or printer_state == "paused" %}
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=accel VALUE={printer.toolhead.max_accel}
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=accel_to_decel VALUE={printer.toolhead.max_accel_to_decel}
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=velocity VALUE={printer.toolhead.max_velocity}
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=square_corner_velocity VALUE={printer.toolhead.square_corner_velocity}
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=pressure_advance VALUE={printer.extruder.pressure_advance}
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=speed_factor VALUE={printer.gcode_move.speed_factor}
	
	
	SET_VELOCITY_LIMIT ACCEL=2500
	SET_VELOCITY_LIMIT ACCEL_TO_DECEL=2500
	SET_VELOCITY_LIMIT VELOCITY=150
	SET_VELOCITY_LIMIT SQUARE_CORNER_VELOCITY=5
	SET_PRESSURE_ADVANCE ADVANCE=0.05
	M220 S50
	
	{% set tmp = printer['output_pin fan0'].value * 255 %}
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=fan0_value VALUE={tmp}
	{% if tmp - printer['gcode_macro PRINTER_PARAM'].fan0_min > (255 - printer['gcode_macro PRINTER_PARAM'].fan0_min) / 2 %}
	{% set tmp = printer['gcode_macro PRINTER_PARAM'].fan0_min + (255 - printer['gcode_macro PRINTER_PARAM'].fan0_min) / 2 %}
	SET_PIN PIN=fan0 VALUE={tmp}
	{% endif %}
	
	
	
	
	
	
	
	
	{% set tmp = printer['output_pin fan2'].value * 255 %}
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=fan2_value VALUE={printer['output_pin fan2'].value * 255}
	{% if tmp - printer['gcode_macro PRINTER_PARAM'].fan2_min > (255 - printer['gcode_macro PRINTER_PARAM'].fan2_min) / 2 %}
	{% set tmp = printer['gcode_macro PRINTER_PARAM'].fan2_min + (255 - printer['gcode_macro PRINTER_PARAM'].fan2_min) / 2 %}
	SET_PIN PIN=fan2 VALUE={tmp}
	{% endif %}
	
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=flag VALUE=1
	SET_QMODE_FLAG FLAG=1
	{% endif %}
	{% endif %}

[gcode_macro Qmode_exit]
gcode = 
	{% set printer_state = printer.print_stats.state %}
	{% if printer['gcode_macro Qmode'].flag|int == 1 %}
	{% if printer_state == "printing" or printer_state == "paused" %}
	SET_VELOCITY_LIMIT ACCEL={printer['gcode_macro Qmode'].accel}
	SET_VELOCITY_LIMIT ACCEL_TO_DECEL={printer['gcode_macro Qmode'].accel_to_decel}
	SET_VELOCITY_LIMIT VELOCITY={printer['gcode_macro Qmode'].velocity}
	SET_VELOCITY_LIMIT SQUARE_CORNER_VELOCITY={printer['gcode_macro Qmode'].square_corner_velocity}
	SET_PRESSURE_ADVANCE ADVANCE={printer['gcode_macro Qmode'].pressure_advance}
	M220 S{printer['gcode_macro Qmode'].speed_factor * 100}
	
	{% if printer['output_pin fan0'].value != 0 %}
	{action_respond_info("fan0_value = %s" % printer['gcode_macro Qmode'].fan0_value)}
	SET_PIN PIN=fan0 VALUE={printer['gcode_macro Qmode'].fan0_value}
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=fan0_value VALUE=0
	{% endif %}
	
	
	
	
	
	{% if printer['output_pin fan2'].value != 0 %}
	{action_respond_info("fan2_value = %s" % printer['gcode_macro Qmode'].fan2_value)}
	SET_PIN PIN=fan2 VALUE={printer['gcode_macro Qmode'].fan2_value}
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=fan2_value VALUE=0
	{% endif %}
	
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=flag VALUE=0
	SET_QMODE_FLAG FLAG=0
	{% endif %}
	{% endif %}

[gcode_macro M204]
rename_existing = M204.1
gcode = 
	
	{% set get_params = "" %}
	{% set qmode_max_accel = printer['gcode_macro Qmode'].max_accel|string %}
	{% if 'S' in params|upper %}
	{% if printer['gcode_macro Qmode'].flag|int == 1 and params.S|float > qmode_max_accel|float %}
	{% set get_params = (get_params + ' ' + 'S' + qmode_max_accel) %}
	{% else %}
	{% set get_params = (get_params + ' ' + 'S' + params.S) %}
	{% endif %}
	{% endif %}
	{% if 'P' in params|upper %}
	{% if printer['gcode_macro Qmode'].flag|int == 1 and params.P|float > qmode_max_accel|float %}
	{% set get_params = (get_params + ' ' + 'P' + qmode_max_accel) %}
	{% else %}
	{% set get_params = (get_params + ' ' + 'P' + params.P) %}
	{% endif %}
	{% endif %}
	{% if 'T' in params|upper %}
	{% if printer['gcode_macro Qmode'].flag|int == 1 and params.T|float > qmode_max_accel|float %}
	{% set get_params = (get_params + ' ' + 'T' + qmode_max_accel) %}
	{% else %}
	{% set get_params = (get_params + ' ' + 'T' + params.T) %}
	{% endif %}
	{% endif %}
	M204.1 {get_params}

[gcode_macro M205]
gcode = 
	{% if 'X' in params %}
	SET_VELOCITY_LIMIT SQUARE_CORNER_VELOCITY={params.X}
	{% elif 'Y' in params %}
	SET_VELOCITY_LIMIT SQUARE_CORNER_VELOCITY={params.Y}
	{% endif %}

[gcode_macro M106]
gcode = 
	{% set fans = printer["gcode_macro PRINTER_PARAM"].fans|int %}
	{% set fan = 0 %}
	{% set value = 0 %}
	{% if params.P is defined %}
	{% set tmp = params.P|int %}
	{% if tmp < fans %}
	{% set fan = tmp %}
	{% endif %}
	{% endif %}
	{% if params.S is defined %}
	{% set tmp = params.S|float %}
	{% else %}
	{% set tmp = 255 %}
	{% endif %}
	{% if tmp > 0 %}
	{% if fan == 0 %}
	{% set value = (255 - printer["gcode_macro PRINTER_PARAM"].fan0_min) / 255 * tmp %}
	{% if printer['gcode_macro Qmode'].flag | int == 1 %}
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=fan0_value VALUE={printer["gcode_macro PRINTER_PARAM"].fan0_min + value}
	{% if value > (255 - printer['gcode_macro PRINTER_PARAM'].fan0_min) / 2  %}
	{% set value = printer["gcode_macro PRINTER_PARAM"].fan0_min + (255 - printer['gcode_macro PRINTER_PARAM'].fan0_min) / 2 %}
	{% else %}
	{% set value = printer["gcode_macro PRINTER_PARAM"].fan0_min + value %}
	{% endif %}
	{% else %}
	{% set value = printer["gcode_macro PRINTER_PARAM"].fan0_min + value %}
	{% endif %}
	{% endif %}
	{% if fan == 1 %}
	{% set value = (255 - printer["gcode_macro PRINTER_PARAM"].fan1_min) / 255 * tmp %}
	{% if printer['gcode_macro Qmode'].flag | int == 1 %}
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=fan1_value VALUE={printer["gcode_macro PRINTER_PARAM"].fan1_min + value}
	{% if value > (255 - printer['gcode_macro PRINTER_PARAM'].fan1_min) / 2  %}
	{% set value = printer["gcode_macro PRINTER_PARAM"].fan1_min + (255 - printer['gcode_macro PRINTER_PARAM'].fan1_min) / 2 %}
	{% else %}
	{% set value = printer["gcode_macro PRINTER_PARAM"].fan1_min + value %}
	{% endif %}
	{% else %}
	{% set value = printer["gcode_macro PRINTER_PARAM"].fan1_min + value %}
	{% endif %}
	{% endif %}
	{% if fan == 2 %}
	{% set value = (255 - printer["gcode_macro PRINTER_PARAM"].fan2_min) / 255 * tmp %}
	{% if printer['gcode_macro Qmode'].flag | int == 1 %}
	SET_GCODE_VARIABLE MACRO=Qmode VARIABLE=fan2_value VALUE={printer["gcode_macro PRINTER_PARAM"].fan2_min + value}
	{% if value > (255 - printer['gcode_macro PRINTER_PARAM'].fan2_min) / 2  %}
	{% set value = printer["gcode_macro PRINTER_PARAM"].fan2_min + (255 - printer['gcode_macro PRINTER_PARAM'].fan2_min) / 2 %}
	{% else %}
	{% set value = printer["gcode_macro PRINTER_PARAM"].fan2_min + value %}
	{% endif %}
	{% else %}
	{% set value = printer["gcode_macro PRINTER_PARAM"].fan2_min + value %}
	{% endif %}
	{% endif %}
	{% endif %}
	{% if value >= 255 %}
	{% set value = 255 %}
	{% endif %}
	SET_PIN PIN=fan{fan} VALUE={value}

[gcode_macro SET_PIN]
rename_existing = SET_PIN_BASE
gcode = 
	{% set pin = params.PIN|default("")|lower %}
	{% set value = params.VALUE|float %}
	{% if pin == "fan2" %}
	{% if value == 0 %}
	SET_PIN_BASE PIN=fan2_en VALUE=0
	{% else %}
	SET_PIN_BASE PIN=fan2_en VALUE=1
	{% endif %}
	{% endif %}
	{% if pin == "fan0" %}
	{% if value == 0 %}
	SET_PIN_BASE PIN=fan0_en VALUE=0
	{% else %}
	SET_PIN_BASE PIN=fan0_en VALUE=1
	{% endif %}
	{% endif %}
	{% if pin == "fan1" %}
	{% set hw_max = printer["gcode_macro PRINTER_PARAM"].fan1_hw_max|int %}
	{% if value > 0 %}
	{% set pct = (value * 100 / 255 - 0.001)|round(0, 'ceil')|int %}
	{% if pct > 100 %}{% set pct = 100 %}{% endif %}
	{% set value = ((pct * hw_max + 50)|int / 100)|round(0, 'floor')|int %}
	CHAMBER_MANUAL_OUTER_FAN
	SET_OUTER_FAN_HW VALUE={value}
	{% else %}
	CHAMBER_MANUAL_OUTER_FAN CLEAR=1
	SET_OUTER_FAN_HW VALUE=0
	{% endif %}
	{% else %}
	SET_PIN_BASE {rawparams}
	{% endif %}

[gcode_macro M107]
gcode = 
	{% set fans = printer["gcode_macro PRINTER_PARAM"].fans|int %}
	{% if params.P is defined %}
	{% if params.P|int < fans %}
	SET_PIN PIN=fan{params.P|int} VALUE=0
	{% else %}
	SET_PIN PIN=fan0 VALUE=0
	{% endif %}
	{% else %}
	SET_PIN PIN=fan0 VALUE=0
	SET_PIN PIN=fan2 VALUE=0
	{% endif %}

[gcode_macro M900]
gcode = 
	{% if 'K' in params %}
	{% if 'E' in params %}
	SET_PRESSURE_ADVANCE EXTRUDER={params.E} ADVANCE={params.K}
	{% else %}
	SET_PRESSURE_ADVANCE ADVANCE={params.K}
	{% endif %}
	{% endif %}

[gcode_macro USER_SET_EXTRUDER_TEMPERATURE]
gcode = 
	{% set get_target = (0) %}
	{% if 'TARGET' in params|upper %}
	{% set get_target = (params.TARGET) %}
	{% endif %}
	{% set get_extruder = 'extruder' %}
	{% if 'EXTRUDER' in params|upper and params.EXTRUDER|int != 0 %}
	{% set get_extruder = (get_extruder + params.EXTRUDER) %}
	{% endif %}
	SET_HEATER_TEMPERATURE HEATER={get_extruder} TARGET={get_target}

[delayed_gcode wait_temp]
gcode = 
	{% set cur_temp = printer.extruder.temperature %}
	{% if cur_temp|int < 40 %}
	{action_respond_info("end_temp!\n")}
	WAIT_TEMP_END
	{% else %}
	{action_respond_info("cur_temp = %s \n" % (cur_temp))}
	UPDATE_DELAYED_GCODE ID=wait_temp DURATION=5
	{% endif %}

[gcode_macro WAIT_TEMP_START]
gcode = 
	UPDATE_DELAYED_GCODE ID=wait_temp DURATION=1
	M106 P0 S255

[gcode_macro WAIT_TEMP_END]
gcode = 
	UPDATE_DELAYED_GCODE ID=wait_temp DURATION=0
	M106 P0 S0

[delayed_gcode pause_fan_stop]
gcode = 
	{action_respond_info("pause_fan_stop: model fan blow done, stop fans")}
	M106 P2 S0
	M106 P0 S0
	SET_PIN PIN=extruder_fan VALUE=0

[delayed_gcode error_pause_unlock_xy]
gcode = 
	{% if printer['gcode_macro PRINTER_PARAM'].error_pause|int == 1 %}
	SET_STEPPER_ENABLE STEPPER=stepper_x ENABLE=0
	SET_STEPPER_ENABLE STEPPER=stepper_y ENABLE=0
	{action_respond_info("ERROR_PAUSE: XY unlocked (nozzle-change only, Z stays enabled)")}
	{% endif %}

[gcode_macro PRINT_CALIBRATION]
gcode = 
	CX_PRINT_LEVELING_CALIBRATION

[gcode_macro FIRST_FLOOR_PAUSE_POSITION]
gcode = 
	{% set extruder_temp = printer.custom_macro.g28_ext_temp %}
	M104 S{extruder_temp}
	{% set y_park = printer.toolhead.axis_maximum.y/2 %}
	{% set x_park = printer['gcode_macro PRINTER_PARAM'].max_x_position|float + 1 %}
	G90
	G1 Z2 F600
	G1 X{x_park} Y{y_park} F6000
	G1 Z0.2 F600

[gcode_macro ACCURATE_G28]
gcode = 
	ACCURATE_HOME_Z

[gcode_macro PRINT_TEMP_SET]
gcode = 
	{% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(220)|float %}
	{% set BED_TEMP = params.BED_TEMP|default(60)|float %}
	{% set EXTRUDER_WAITTEMP = (140.0|float)|int %}
	{% set WAIT_TEMP = params.WAIT_TEMP|default(0)|int %}
	M106 S0
	M140 S{BED_TEMP}
	M104 S{EXTRUDER_WAITTEMP}
	SET_VELOCITY_LIMIT ACCEL=5000 ACCEL_TO_DECEL=5000
	{% if WAIT_TEMP|int == 1 %}
	M104 S{EXTRUDER_WAITTEMP}
	M190 S{BED_TEMP}
	M109 S{EXTRUDER_WAITTEMP}
	{% endif %}

[gcode_macro ZDOWN_SWITCH_SET]
gcode = 
	ZDOWN_SWITCH ENABLE={params.VALUE}

[gcode_macro SET_CHAMBER_FAN]
gcode = 
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	{action_respond_info("SET_CHAMBER_FAN")}

[gcode_macro RESPONSE_INFO]
gcode = 
	{% set msg = params.MSG | default("response info") %}
	{ action_respond_info(msg) }

[gcode_macro SET_EXTRUDER_TEMP]
gcode = 
	{% set idx = params.NUM|default(0)|int %}
	{% set temp = params.TARGET|default(0)|int %}
	{% if idx == 0 %}
	SET_HEATER_TEMPERATURE HEATER=extruder TARGET={temp}
	{% else %}
	SET_HEATER_TEMPERATURE HEATER=extruder{idx} TARGET={temp}
	{% endif %}

[gcode_macro START_PRINT]
variable_prepare = 0
gcode = 
	{% if printer['gcode_macro START_PRINT'].prepare|int == 0 %}
	SAVE_IDLE_PREPRINT_TEMP
	{% endif %}
	{% set BED_TEMP = params.BED_TEMP|default(60)|float %}
	M140 S{params.BED_TEMP}
	BOARD_FAN_ON
	
	G90
	
	{% set g28_extruder_temp = printer.custom_macro.g28_ext_temp %}
	{% set bed_temp = printer.custom_macro.default_bed_temp %}
	{% set extruder_temp = printer.custom_macro.default_extruder_temp %}
	
	{% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(220)|float %}
	
	{% set EXTRUDER_WAITTEMP = (140.0|float)|int %}
	
	{% if printer['gcode_macro START_PRINT'].prepare|int == 0 %}
	{action_respond_info("print prepared 111")}
	
	MCLIB_SET_CURRENT STEPPER=stepper_z CURRENT=1.5 HOLDCURRENT=0.8
	
	M106 S0
	M140 S{params.BED_TEMP}
	M104 S{EXTRUDER_WAITTEMP}
	SET_VELOCITY_LIMIT ACCEL=5000 ACCEL_TO_DECEL=5000
	G28
	
	
	NOZZLE_CLEAR
	
	M104 S{EXTRUDER_WAITTEMP}
	M190 S{params.BED_TEMP}
	M109 S{EXTRUDER_WAITTEMP}
	
	
	
	
	NEXT_HOMEZ_NACCU
	
	G28 Z
	BOX_START_PRINT
	{% else %}
	PRINT_PREPARE_CLEAR
	{% endif %}
	M140 S{params.BED_TEMP}
	
	
	
	M190 S{params.BED_TEMP}
	
	BOX_FIRST_NOZZLE_HEATING T={params.EXTRUDER_TEMP}; wait first print nozzle heating
	
	
	
	M220 S100
	
	G21
	SET_VELOCITY_LIMIT SQUARE_CORNER_VELOCITY=10
	M204 S5000
	SET_VELOCITY_LIMIT ACCEL_TO_DECEL=5000
	
	
	G92 E0
	SET_PIN PIN=extruder_fan VALUE=1

[gcode_macro PRINT_PREPARED]
gcode = 
	SET_GCODE_VARIABLE MACRO=START_PRINT VARIABLE=prepare VALUE=1
	
	
	
	{action_respond_info("print prepared")}

[gcode_macro PRINT_PREPARE_CLEAR]
gcode = 
	SET_GCODE_VARIABLE MACRO=START_PRINT VARIABLE=prepare VALUE=0

[gcode_macro END_PRINT_POINT_WITHOUT_LIFTING]
gcode = 
	{% if "xyz" in printer.toolhead.homed_axes %}
	{% set E = printer["gcode_macro PAUSE"].extrude|float %}
	{% set max_z = printer["gcode_macro PRINTER_PARAM"].max_z_position|float %}
	{% set act_z = printer.toolhead.position.z|float %}
	G91
	{% if printer.extruder.can_extrude|lower == 'true' %}
	G1 E-1.0 F180
	G1 E-{E} F4000
	{% else %}
	{action_respond_info("Extruder not hot enough")}
	{% endif %}
	{% if act_z < (max_z - 5) %}
	G1 Z2.0 F600
	{% endif %}
	G90
	{% set y_park = printer.toolhead.axis_maximum.y/2 %}
	{% set x_park = printer.toolhead.axis_maximum.x|float - 10.0 %}
	G1 X{x_park} Y{y_park} F30000
	{% else %}
	{action_respond_info("end print xyz_axes is NULL\n")}
	{% endif %}

[gcode_macro END_PRINT_Z_SAFE]
gcode = 
	{% if "xyz" in printer.toolhead.homed_axes %}
	{% set max_z = printer["gcode_macro PRINTER_PARAM"].max_z_position|float %}
	{% set act_z = printer.toolhead.position.z|float %}
	G91
	{action_respond_info("END_PRINT_Z_SAFE act_z:%s, max_z:%s \n" % (act_z, max_z))}
	{% if act_z < (max_z - 5) %}
	{action_respond_info("END_PRINT_Z_SAFE G1 Z2.0 F600 \n")}
	G1 Z2.0 F600
	{% endif %}
	G90
	{% else %}
	{action_respond_info("end print xyz_axes is NULL\n")}
	{% endif %}

[gcode_macro END_PRINT_POINT]
gcode = 
	{% if "xyz" in printer.toolhead.homed_axes %}
	{% set E = printer["gcode_macro PAUSE"].extrude|float %}
	{% set max_z = printer["gcode_macro PRINTER_PARAM"].max_z_position|float %}
	{% set act_z = printer.toolhead.position.z|float %}
	{% set z_safe = 0.0 %}
	{% if act_z < (max_z / 2) %}
	{% set z_safe = (max_z / 2) - act_z %}
	{% elif act_z < max_z %}
	{% set z_safe = 2.0 %}
	{% endif %}
	G91
	{% if printer.extruder.can_extrude|lower == 'true' %}
	G1 E-1.0 F180
	G1 E-{E} F4000
	{% else %}
	{action_respond_info("Extruder not hot enough")}
	{% endif %}
	
	
	
	
	
	G90
	
	
	
	{% if z_safe > 2.0 %}
	G91
	{% set z_safe = z_safe - 2.0 %}
	G1 Z{z_safe} F600
	G90
	{% endif %}
	{% else %}
	{action_respond_info("end print xyz_axes is NULL\n")}
	{% endif %}

[gcode_macro END_PRINT_UNLOAD_CURRENT_NOZZLE]
gcode = 
	
	{% set selected = printer.nozzle_manager.selected | int %}
	{% if selected >= 0 %}
	
	SET_FILAMENT_SENSOR SENSOR=filament_sensor ENABLE=0
	{action_respond_info("END_PRINT NOZZLE_RELEASE NOZZLE=%s" % selected)}
	NOZZLE_RELEASE NOZZLE={selected}
	SET_FILAMENT_SENSOR SENSOR=filament_sensor ENABLE=1
	M400
	{% else %}
	BOX_MOVE_TO_SAFE_POS
	{action_respond_info("END_PRINT no nozzle loaded, skip release")}
	{% endif %}

[gcode_macro END_PRINT]
gcode = 
	
	UPDATE_DELAYED_GCODE ID=pause_fan_stop DURATION=0
	RESTORE_LIMITS
	ENABLE_PRESSURE_ADVANCE VALUE=1
	M400
	G92 E0
	BOX_END
	BOX_END_PRINT
	
	SET_PRINT_MODE MODE=standard
	EXCLUDE_OBJECT_RESET
	PRINT_PREPARE_CLEAR
	M220 S100
	SET_VELOCITY_LIMIT ACCEL=5000 ACCEL_TO_DECEL=5000
	{% if "xyz" in printer.toolhead.homed_axes %}
	
	{% set act_z = printer.toolhead.position.z|float %}
	{% set max_z = printer["gcode_macro PRINTER_PARAM"].max_z_position|float %}
	{% set z_mid = max_z / 2.0 %}
	{% if act_z > 130.0 %}
	{% set z_target = max_z %}
	{% else %}
	{% set z_target = z_mid %}
	{% endif %}
	{action_respond_info("END_PRINT act_z=%s z_target=%s"% (act_z, z_target))}
	G90
	{% if act_z < z_target %}
	G1 Z{z_target} F600
	{% endif %}
	END_PRINT_UNLOAD_CURRENT_NOZZLE
	{% elif "xy" in printer.toolhead.homed_axes and "z" not in printer.toolhead.homed_axes %}
	END_PRINT_UNLOAD_CURRENT_NOZZLE
	{% else %}
	{action_respond_info("end print xyz_axes is NULL\n")}
	{% endif %}
	
	SET_EXTRUDER_TEMP NUM=0 TARGET=0
	SET_EXTRUDER_TEMP NUM=1 TARGET=0
	SET_EXTRUDER_TEMP NUM=2 TARGET=0
	SET_EXTRUDER_TEMP NUM=3 TARGET=0
	M140 S0
	M141 S0
	
	{% set fan2_speed = printer['output_pin fan2'].value|float %}
	{% if fan2_speed > 0 %}
	SET_PIN PIN=fan2 VALUE={(fan2_speed * 255 + 0.5)|int}
	{% else %}
	M106 P2 S255
	{% endif %}
	UPDATE_DELAYED_GCODE ID=pause_fan_stop DURATION=10
	
	MCLIB_SET_CURRENT STEPPER=stepper_z RESTORE=1
	
	M84

[gcode_macro M84]
rename_existing = M84.1
gcode = 
	M84.1
	BOARD_FAN_OFF

[gcode_macro CANCEL_PRINT_EXTERNAL]
gcode = 
	
	UPDATE_DELAYED_GCODE ID=pause_fan_stop DURATION=0
	RESTORE_LIMITS
	ENABLE_PRESSURE_ADVANCE VALUE=1
	M400
	G92 E0
	BOX_END
	BOX_END_PRINT
	
	SET_PRINT_MODE MODE=standard
	EXCLUDE_OBJECT_RESET
	PRINT_PREPARE_CLEAR
	M220 S100
	SET_VELOCITY_LIMIT ACCEL=5000 ACCEL_TO_DECEL=5000
	{% if "xyz" in printer.toolhead.homed_axes %}
	
	{% set act_z = printer.toolhead.position.z|float %}
	{% set max_z = printer["gcode_macro PRINTER_PARAM"].max_z_position|float %}
	{% set z_mid = max_z / 2.0 %}
	{% if act_z > 130.0 %}
	{% set z_target = max_z %}
	{% else %}
	{% set z_target = z_mid %}
	{% endif %}
	{action_respond_info("CANCEL_PRINT act_z=%s z_target=%s"% (act_z, z_target))}
	G90
	{% if act_z < z_target %}
	G1 Z{z_target} F600
	{% endif %}
	M400
	{% else %}
	{action_respond_info("cancel print xyz_axes is NULL\n")}
	{% endif %}
	
	SET_EXTRUDER_TEMP NUM=0 TARGET=0
	SET_EXTRUDER_TEMP NUM=1 TARGET=0
	SET_EXTRUDER_TEMP NUM=2 TARGET=0
	SET_EXTRUDER_TEMP NUM=3 TARGET=0
	M140 S0
	M141 S0
	
	{% set fan2_speed = printer['output_pin fan2'].value|float %}
	{% if fan2_speed > 0 %}
	SET_PIN PIN=fan2 VALUE={(fan2_speed * 255 + 0.5)|int}
	{% else %}
	M106 P2 S255
	{% endif %}
	UPDATE_DELAYED_GCODE ID=pause_fan_stop DURATION=10
	
	MCLIB_SET_CURRENT STEPPER=stepper_z RESTORE=1
	
	M84

[gcode_macro FIRST_FLOOR_PAUSE]
description = Pause the first floor print
variable_extrude = 2.0
gcode = 
	
	{% set E = printer["gcode_macro FIRST_FLOOR_PAUSE"].extrude|float %}
	
	
	{% set y_park = printer.toolhead.axis_maximum.y/2 %}
	{% set x_park = printer.toolhead.axis_maximum.x|float - 10.0 %}
	
	{% set max_z = printer["gcode_macro PRINTER_PARAM"].max_z_position|float %}
	{% set act_z = printer.toolhead.position.z|float %}
	{% set z_safe = 0.0 %}
	{% if act_z < (max_z - 2.0) %}
	{% set z_safe = 2.0 %}
	{% elif act_z < max_z %}
	{% set z_safe = max_z - act_z %}
	{% endif %}
	
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=z_safe_pause VALUE={z_safe|float}
	
	PAUSE_RAW
	G91
	{% if "xyz" in printer.toolhead.homed_axes %}
	{% if printer.extruder.can_extrude|lower == 'true' %}
	G1 E-1.0 F180
	G1 E-{E} F300
	{% else %}
	{action_respond_info("Extruder not hot enough")}
	{% endif %}
	G1 Z{z_safe} F600
	G90
	G1 X{x_park} Y{y_park} F30000
	{% else %}
	{action_respond_info("Printer not homed")}
	{% endif %}
	
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=fan2_speed VALUE={printer['output_pin fan2'].value}
	{% set fspeed = printer['gcode_macro PRINTER_PARAM'].fan2_speed %}
	{action_respond_info("fan2_value = %s \n" % (fspeed))}
	M106 P2 S0
	M106 S0

[gcode_macro FIRST_FLOOR_RESUME]
description = Resume the first floor print
gcode = 
	{% if printer['gcode_macro PRINTER_PARAM'].fan2_speed > 0 %}
	
	
	
	{% set s_value = (printer['gcode_macro PRINTER_PARAM'].fan2_speed * 255 - printer['gcode_macro PRINTER_PARAM'].fan2_min) * 255 / (255 - printer['gcode_macro PRINTER_PARAM'].fan2_min)|float %}
	M106 P2 S{s_value}
	{% endif %}
	
	{% set E = printer["gcode_macro FIRST_FLOOR_PAUSE"].extrude|float + 1.0 %}
	
	{% if 'VELOCITY' in params|upper %}
	{% set get_params = ('VELOCITY=' + params.VELOCITY) %}
	{%else %}
	{% set get_params = "" %}
	{% endif %}
	
	{% if printer.extruder.can_extrude|lower == 'true' %}
	G91
	G1 E{E} F2100
	{% else %}
	{action_respond_info("Extruder not hot enough")}
	{% endif %}
	M400
	RESUME_BASE {get_params}

[gcode_macro PAUSE]
description = Pause the actual running print
rename_existing = PAUSE_RAW
variable_extrude = 2.0
gcode = 
	{% if printer.pause_resume.is_paused|lower == 'false' %}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=error_pause VALUE=0
	
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=pause_x VALUE={printer.gcode_move.gcode_position.x|float}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=pause_y VALUE={printer.gcode_move.gcode_position.y|float}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=pause_z VALUE={printer.gcode_move.gcode_position.z|float}
	{action_respond_info("pause_xyz(print)=%s,%s,%s" % (printer.gcode_move.gcode_position.x, printer.gcode_move.gcode_position.y, printer.gcode_move.gcode_position.z))}
	PAUSE_RAW
	PAUSE_EXTERNAL
	{% endif %}

[gcode_macro ERROR_PAUSE]
description = Nozzle-change error pause only (STAY=1); else ordinary PAUSE
gcode = 
	{% set stay = params.STAY|default(0)|int %}
	{% if stay != 1 %}
	{action_respond_info("ERROR_PAUSE: non-nozzle-change → PAUSE")}
	PAUSE
	{% elif printer.pause_resume.is_paused|lower == 'false' %}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=error_pause VALUE=1
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=pause_x VALUE={printer.gcode_move.gcode_position.x|float}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=pause_y VALUE={printer.gcode_move.gcode_position.y|float}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=pause_z VALUE={printer.gcode_move.gcode_position.z|float}
	{action_respond_info("ERROR_PAUSE stay=1 pause_xyz=%s,%s,%s" % (printer.gcode_move.gcode_position.x, printer.gcode_move.gcode_position.y, printer.gcode_move.gcode_position.z))}
	PAUSE_RAW
	PAUSE_ERROR_EXTERNAL
	{% else %}
	
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=error_pause VALUE=1
	SET_STEPPER_ENABLE STEPPER=stepper_x ENABLE=0
	SET_STEPPER_ENABLE STEPPER=stepper_y ENABLE=0
	{action_respond_info("ERROR_PAUSE already paused, XY unlock (nozzle-change)")}
	UPDATE_DELAYED_GCODE ID=error_pause_unlock_xy DURATION=2.5
	{% endif %}

[gcode_macro PAUSE_BASE]
gcode = 
	ERROR_PAUSE STAY=1

[gcode_macro PAUSE_EXTERNAL]
gcode = 
	
	{% set act_z = printer.gcode_move.gcode_position.z|float %}
	{% set peak_z = printer.gcode_move.max_printed_z|default(0)|float %}
	{% set max_z = printer["gcode_macro PRINTER_PARAM"].max_z_position|float %}
	{% set clear_z = [act_z + 2.0, peak_z + 2.0]|max %}
	{% set clear_z = [clear_z, max_z]|min %}
	{% set z_safe = [clear_z - act_z, 0.0]|max %}
	{action_respond_info("z_safe = %s act_z=%s peak_z=%s clear_z=%s"% (z_safe, act_z, peak_z, clear_z))}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=z_safe_pause VALUE={z_safe|float}
	
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=fan2_speed VALUE={printer['output_pin fan2'].value}
	{% set fspeed = printer['output_pin fan2'].value %}
	{action_respond_info("fan2_value = %s \n" % (fspeed))}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=fan0_speed VALUE={printer['output_pin fan0'].value}
	{% set fspeed = printer['output_pin fan0'].value %}
	{action_respond_info("fan0_value = %s \n" % (fspeed))}
	
	{% set selected_nozzle = printer.nozzle_manager.selected | int %}
	{% if selected_nozzle > 0 %}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=hotend_temp VALUE={printer['extruder' ~ selected_nozzle].target}
	{% else %}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=hotend_temp VALUE={printer.extruder.target}
	{% endif %}
	RESPONSE_INFO MSG=hotend_temp:{printer['gcode_macro PRINTER_PARAM'].hotend_temp}selected_nozzle:{selected_nozzle}
	
	SET_LIMITS
	M220 S100
	M400
	{% if "xyz" in printer.toolhead.homed_axes %}
	
	G91
	G1 Z{z_safe} F600
	G90
	BOX_GOTO_EXTRUDE_POS_AND_CLEAN
	M400
	{% else %}
	{action_respond_info("Printer not homed")}
	{% endif %}
	
	BOX_PAUSE_SET_NOZZLE_TEMP TARGET=140
	
	{% if printer['gcode_macro PRINTER_PARAM'].fan2_speed > 0 %}
	SET_PIN PIN=fan2 VALUE={(printer['gcode_macro PRINTER_PARAM'].fan2_speed * 255 + 0.5)|int}
	{% else %}
	M106 P2 S255
	{% endif %}
	UPDATE_DELAYED_GCODE ID=pause_fan_stop DURATION=10
	RESTORE_LIMITS

[gcode_macro PAUSE_ERROR_EXTERNAL]
gcode = 
	{% set err_mode = printer['gcode_macro PRINTER_PARAM'].error_pause|int %}
	
	{% set act_z = printer.gcode_move.gcode_position.z|float %}
	{% set peak_z = printer.gcode_move.max_printed_z|default(0)|float %}
	{% set max_z = printer["gcode_macro PRINTER_PARAM"].max_z_position|float %}
	{% set clear_z = [act_z + 2.0, peak_z + 2.0]|max %}
	{% set clear_z = [clear_z, max_z]|min %}
	{% set z_safe = [clear_z - act_z, 0.0]|max %}
	{action_respond_info("PAUSE_ERROR_EXTERNAL mode=%s z_safe=%s act_z=%s peak_z=%s" % (err_mode, z_safe, act_z, peak_z))}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=z_safe_pause VALUE={z_safe|float}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=fan2_speed VALUE={printer['output_pin fan2'].value}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=fan0_speed VALUE={printer['output_pin fan0'].value}
	{% set selected_nozzle = printer.nozzle_manager.selected | int %}
	{% if selected_nozzle > 0 %}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=hotend_temp VALUE={printer['extruder' ~ selected_nozzle].target}
	{% else %}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=hotend_temp VALUE={printer.extruder.target}
	{% endif %}
	RESPONSE_INFO MSG=ERROR_PAUSE_hotend_temp:{printer['gcode_macro PRINTER_PARAM'].hotend_temp}mode:{err_mode}
	SET_LIMITS
	M220 S100
	M400
	{% if "xyz" in printer.toolhead.homed_axes %}
	G91
	G1 Z{z_safe} F600
	G90
	M400
	{% if err_mode == 2 %}
	
	BOX_GO_TO_EXTRUDE_POS
	M400
	{% else %}
	
	{action_respond_info("ERROR_PAUSE stay in place XY, bed/Z down %s mm (nozzle change error)" % (z_safe))}
	{% endif %}
	{% else %}
	{action_respond_info("Printer not homed, skip Z lift / flush move")}
	{% endif %}
	RESTORE_LIMITS
	
	BOX_PAUSE_SET_NOZZLE_TEMP TARGET=140
	{% if printer['gcode_macro PRINTER_PARAM'].fan2_speed > 0 %}
	SET_PIN PIN=fan2 VALUE={(printer['gcode_macro PRINTER_PARAM'].fan2_speed * 255 + 0.5)|int}
	{% else %}
	M106 P2 S255
	{% endif %}
	UPDATE_DELAYED_GCODE ID=pause_fan_stop DURATION=10
	
	{% if err_mode == 1 %}
	SET_STEPPER_ENABLE STEPPER=stepper_x ENABLE=0
	SET_STEPPER_ENABLE STEPPER=stepper_y ENABLE=0
	{action_respond_info("ERROR_PAUSE: XY unlock requested (nozzle-change)")}
	UPDATE_DELAYED_GCODE ID=error_pause_unlock_xy DURATION=2.5
	{% else %}
	{action_respond_info("ERROR_PAUSE: skip XY unlock mode=%s" % err_mode)}
	{% endif %}

[gcode_macro CALIBRATE_CUT_POS]
gcode = 
	
	
	
	{% if "NUM" in params|upper %}
	{% set NUM = params.NUM %}
	{%else %}
	{% set NUM = 0 %}
	{% endif %}
	SET_LIMITS
	SET_GCODE_OFFSET X=0
	
	CUT_XPOS_CALC
	MULIT_NOZZLE_OFFSET_SET NUM={NUM}
	M400
	RESTORE_LIMITS

[gcode_macro INPUTSHAPER]
gcode = 
	{% set enabled = printer["filament_switch_sensor filament_sensor"].enabled %}
	{% if enabled %}
	SET_FILAMENT_SENSOR SENSOR=filament_sensor ENABLE=0
	{% endif %}
	G90
	{% if "xyz" not in printer.toolhead.homed_axes %}
	G28
	{% endif %}
	{% set POSITION_X = printer.configfile.settings['stepper_x'].position_max/2 %}
	{% set POSITION_Y = printer.configfile.settings['stepper_y'].position_max/2 %}
	G1 X{POSITION_X} Y{POSITION_Y} F6000
	G1 Z10 F600
	SHAPER_CALIBRATE
	SHAPER_CALIBRATE AXIS=Z
	GO_TO_FIRST_CUT_POS
	G1 X{POSITION_X} Y{POSITION_Y} F6000
	M400
	RESTORE_LIMITS
	CXSAVE_CONFIG
	{% if enabled %}
	SET_FILAMENT_SENSOR SENSOR=filament_sensor ENABLE=1
	{% endif %}

[gcode_macro BELT_TENSION]
gcode = 
	G90
	{% if "xy" not in printer.toolhead.homed_axes %}
	G28 X Y
	{% endif %}
	BED_MESH_CLEAR
	BOX_MOVE_TO_SAFE_POS
	M400
	G1 Y280 F7800
	G1 X172 F7800
	M400
	M84
	{% if 'X' in params.AXES|upper %}
	BELT_MDL_INFO MDL_NAME=mdlx
	BELT_MDL_SET MDL_NAME=mdlx MDL_N=140
	{% elif 'Y' in params.AXES|upper %}
	BELT_MDL_INFO MDL_NAME=mdly
	BELT_MDL_SET MDL_NAME=mdly MDL_N=140
	{% else %}
	BELT_MDL_INFO MDL_NAME=mdlx
	BELT_MDL_SET MDL_NAME=mdlx MDL_N=140
	BELT_MDL_INFO MDL_NAME=mdly
	BELT_MDL_SET MDL_NAME=mdly MDL_N=140
	{% endif %}
	SET_MAINTENANCE_ITEM_VARIABLE NAME=calibrate VARIABLE=belt_tensioning VALUE=0

[gcode_macro BEDPID]
gcode = 
	PID_CALIBRATE HEATER=heater_bed TARGET=100
	SAVE_CONFIG

[gcode_macro NOZZLE_PID]
gcode = 
	SET_PIN PIN=fan0 VALUE=255
	PID_CALIBRATE HEATER=extruder TARGET=230
	SAVE_CONFIG
	SET_PIN PIN=fan0 VALUE=0

[gcode_macro NOZZLE_PID_HIGH]
gcode = 
	SET_PIN PIN=fan0 VALUE=255
	PID_CALIBRATE HEATER=extruder TARGET=320
	SAVE_CONFIG
	SET_PIN PIN=fan0 VALUE=0

[gcode_macro TUNOFFINPUTSHAPER]
gcode = 
	SET_INPUT_SHAPER SHAPER_FREQ_X=0 SHAPER_FREQ_Y=0

[gcode_macro RESUME]
description = Resume the actual running print
rename_existing = RESUME_BASE
gcode = 
	
	BOX_CHECK_RESUME_CONNECT
	RESUME_AFTER_CONNECT_CHECK {rawparams}

[gcode_macro RESUME_AFTER_CONNECT_CHECK]
gcode = 
	{% set box_en = printer.box.enable|default(0)|int %}
	{% set box_st = printer.box.state|default('None') %}
	{% set box_on = printer.box.is_online|default(false) %}
	{% if printer.pause_resume.resume_err %}
	{action_respond_info("RESUME aborted: nano/box not connected")}
	RESUME_BASE
	{% elif box_en == 1 and (box_st != 'connect' or not box_on) %}
	
	{action_respond_info("RESUME aborted by box state=%s is_online=%s" % (box_st, box_on))}
	BOX_ERROR_RESUME_PROCESS
	RESUME_BASE
	{% else %}
	{% if 'VELOCITY' in params|upper %}
	{% set get_params = ('VELOCITY=' + params.VELOCITY) %}
	{% else %}
	{% set get_params = "" %}
	{% endif %}
	{% set box_params = "" %}
	{% if 'IGNORE_PAUSE_MATCH' in params %}
	{% set box_params = 'IGNORE_PAUSE_MATCH=' + params.IGNORE_PAUSE_MATCH|string %}
	{% endif %}
	RESUME_EXTERNAL_PROCESS {box_params}
	
	RESUME_AFTER_ERROR_RESUME {get_params}
	{% endif %}

[gcode_macro RESUME_AFTER_ERROR_RESUME]
gcode = 
	{% if printer.pause_resume.resume_err %}
	{action_respond_info("RESUME aborted after BOX_ERROR_RESUME")}
	RESUME_BASE
	{% else %}
	{% if 'VELOCITY' in params|upper %}
	{% set get_params = ('VELOCITY=' + params.VELOCITY) %}
	{% else %}
	{% set get_params = "" %}
	{% endif %}
	RESUME_BASE {get_params}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=pause_x VALUE=-1.0
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=pause_y VALUE=-1.0
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=pause_z VALUE=-1.0
	{% endif %}

[gcode_macro RESUME_NOZZLE_WIPE]
gcode = 
	{% set n = printer.nozzle_manager.selected|int %}
	{% if n < 0 %}
	{% set n = 0 %}
	{% endif %}
	{% set box = printer.configfile.settings.box %}
	{% set interval = box.nozzle_interval|default(58)|float %}
	{% set clean_l = box.clean_left_pos_x|float + n * interval %}
	{% set clean_r = box.clean_right_pos_x|float + n * interval %}
	{% set extrude_x = box.extrude_pos_x|float + n * interval %}
	{% set clean_y = box.clean_left_pos_y|float %}
	{% set vel = box.clean_velocity|default(6000)|float %}
	{action_respond_info("RESUME_NOZZLE_WIPE from [box] n=%s interval=%s clean=%s~%s y=%s extrude=%s" % (n, interval, clean_l, clean_r, clean_y, extrude_x))}
	G90
	G0 X{clean_r} Y{clean_y} F{vel}
	G0 X{clean_l} F{vel}
	G0 X{clean_r} F{vel}
	G0 X{clean_l} F{vel}
	G0 X{extrude_x} Y{clean_y} F{vel}
	M400

[gcode_macro RESUME_RETURN_TO_PRINT]
gcode = 
	{% set pause_x = printer['gcode_macro PRINTER_PARAM'].pause_x|float %}
	{% set pause_y = printer['gcode_macro PRINTER_PARAM'].pause_y|float %}
	{% set pause_z = printer['gcode_macro PRINTER_PARAM'].pause_z|float %}
	{% set safe_y = printer.configfile.settings['box'].safe_pos_y|float %}
	{% if pause_x < 0 or pause_y < 0 %}
	{action_respond_info("RESUME_RETURN_TO_PRINT skipped, pause_xy=%s,%s" % (pause_x, pause_y))}
	{% elif pause_y > safe_y %}
	{action_respond_info("RESUME_RETURN_TO_PRINT -> BOX_MOVE_TO_SAFE_POS MOVE_X=0")}
	BOX_MOVE_TO_SAFE_POS MOVE_X=0
	
	SAVE_GCODE_STATE NAME=PAUSE_STATE COORD_ONLY=1
	{% else %}
	{action_respond_info("RESUME_RETURN_TO_PRINT -> %s,%s,%s" % (pause_x, pause_y, pause_z))}
	G90
	{% if pause_z >= 0 %}
	G0 X{pause_x} Y{pause_y} Z{pause_z} F24000
	{% else %}
	G0 X{pause_x} Y{pause_y} F24000
	{% endif %}
	M400
	
	SAVE_GCODE_STATE NAME=PAUSE_STATE COORD_ONLY=1
	{% endif %}

[gcode_macro RESUME_EXTERNAL_PROCESS]
gcode = 
	
	
	{% if printer.pause_resume.resume_err %}
	{action_respond_info("RESUME_EXTERNAL_PROCESS skipped: resume_err")}
	{% else %}
	BOX_ERROR_RESUME_PROCESS {rawparams}
	RESUME_EXTERNAL_AFTER_BOX
	{% endif %}

[gcode_macro RESUME_EXTERNAL_AFTER_BOX]
gcode = 
	{% if printer.pause_resume.resume_err %}
	{action_respond_info("RESUME_EXTERNAL skipped: resume_err")}
	{% else %}
	RESUME_EXTERNAL
	{% endif %}

[gcode_macro RESUME_EXTERNAL]
gcode = 
	
	UPDATE_DELAYED_GCODE ID=pause_fan_stop DURATION=0
	UPDATE_DELAYED_GCODE ID=error_pause_unlock_xy DURATION=0
	{% set was_error_pause = printer['gcode_macro PRINTER_PARAM'].error_pause|int %}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=error_pause VALUE=0
	{% if printer.pause_resume.resume_err is none or printer.pause_resume.resume_err|lower == 'false' %}
	
	
	{% if was_error_pause == 1 %}
	{% if printer['gcode_macro PRINTER_PARAM'].hotend_temp|int != 0 %}
	{% if printer['gcode_macro PRINTER_PARAM'].hotend_temp|int > printer.extruder.temperature %}
	M109 S{printer['gcode_macro PRINTER_PARAM'].hotend_temp|int}
	{% else %}
	M104 S{printer['gcode_macro PRINTER_PARAM'].hotend_temp|int}
	{% endif %}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=hotend_temp VALUE=0
	{% endif %}
	{% if printer['gcode_macro PRINTER_PARAM'].fan2_speed > 0 %}
	SET_PIN PIN=fan2 VALUE={(printer['gcode_macro PRINTER_PARAM'].fan2_speed * 255 + 0.5)|int}
	{% endif %}
	{% if printer['gcode_macro PRINTER_PARAM'].fan0_speed > 0 %}
	SET_PIN PIN=fan0 VALUE={(printer['gcode_macro PRINTER_PARAM'].fan0_speed * 255 + 0.5)|int}
	{% endif %}
	SET_LIMITS
	RESUME_RETURN_TO_PRINT
	M400
	SET_PIN PIN=extruder_fan VALUE=1
	{action_respond_info("RESUME after nozzle-change ERROR_PAUSE (stay), returned to pause_xyz")}
	{% else %}
	{% set s_value = 0 %}
	{% set s_value_0 = 0 %}
	
	{% set resume_hotend = printer['gcode_macro PRINTER_PARAM'].hotend_temp|int %}
	{% if printer['gcode_macro PRINTER_PARAM'].fan2_speed > 0 %}
	SET_PIN PIN=fan2 VALUE={(printer['gcode_macro PRINTER_PARAM'].fan2_speed * 255 + 0.5)|int}
	{% set s_value = (printer['gcode_macro PRINTER_PARAM'].fan2_speed * 255 - printer['gcode_macro PRINTER_PARAM'].fan2_min) * 255 / (255 - printer['gcode_macro PRINTER_PARAM'].fan2_min)|float %}
	
	{% endif %}
	{% if printer['gcode_macro PRINTER_PARAM'].fan0_speed > 0 %}
	SET_PIN PIN=fan0 VALUE={(printer['gcode_macro PRINTER_PARAM'].fan0_speed * 255 + 0.5)|int}
	{% set s_value_0 = (printer['gcode_macro PRINTER_PARAM'].fan0_speed * 255 - printer['gcode_macro PRINTER_PARAM'].fan0_min) * 255 / (255 - printer['gcode_macro PRINTER_PARAM'].fan0_min)|float %}
	
	{% endif %}
	BOX_GO_TO_EXTRUDE_POS
	{% set z_resume_move = printer['gcode_macro PRINTER_PARAM'].z_safe_pause|int %}
	{% if z_resume_move > 2 %}
	{% set z_resume_move = z_resume_move - 2 %}
	G91
	
	M400
	{% endif %}
	{action_respond_info("z_resume_move = %s"% (z_resume_move))}
	
	{% set E = printer["gcode_macro PAUSE"].extrude|float + 80.0 %}
	{% set E_VELOCITY = printer['filament_rack'].remain_material_velocity * 0.8 %}
	{action_respond_info("velocity: %s" % (E_VELOCITY))}
	
	{% if 'VELOCITY' in params|upper %}
	{% set get_params = ('VELOCITY=' + params.VELOCITY) %}
	{%else %}
	{% set get_params = "" %}
	{% endif %}
	
	{% if resume_hotend != 0 %}
	{action_respond_info("RESUME heat at extrude pos, M109 S%s" % (resume_hotend))}
	M109 S{resume_hotend}
	SET_GCODE_VARIABLE MACRO=PRINTER_PARAM VARIABLE=hotend_temp VALUE=0
	{% elif printer.extruder.can_extrude|lower == 'false' %}
	{% set wait_t = printer.extruder.target|int %}
	{% if wait_t < 170 %}
	{% set wait_t = 220 %}
	{% endif %}
	{action_respond_info("Extruder not hot enough, SET M109 S%s" % (wait_t))}
	M109 S{wait_t}
	{% endif %}
	
	RESUME_EXTRUDER_EXTRUDE
	
	
	RESUME_NOZZLE_WIPE
	M106 P2 S{s_value}
	M106 P0 S{s_value_0}
	SET_LIMITS
	RESUME_RETURN_TO_PRINT
	M400
	SET_PIN PIN=extruder_fan VALUE=1
	{% endif %}
	{% endif %}

[gcode_macro CANCEL_PRINT]
description = Cancel the actual running print
rename_existing = CANCEL_PRINT_BASE
gcode = 
	{action_respond_info("start CANCEL_PRINT_EXTERNAL")}
	CANCEL_PRINT_EXTERNAL
	{action_respond_info("end CANCEL_PRINT_EXTERNAL success")}
	CANCEL_PRINT_BASE
	{action_respond_info("CANCEL_PRINT success")}
	CLEAR_EEPROM_INFO

[gcode_macro MOTOR_CANCEL_PRINT]
gcode = 
	
	SET_PRINT_MODE MODE=standard
	EXCLUDE_OBJECT_RESET
	PRINT_PREPARE_CLEAR
	M220 S100
	SET_VELOCITY_LIMIT ACCEL=5000 ACCEL_TO_DECEL=5000
	TURN_OFF_HEATERS
	
	M107 P2
	M141 S0
	
	{% set fan2_speed = printer['output_pin fan2'].value|float %}
	{% if fan2_speed > 0 %}
	SET_PIN PIN=fan2 VALUE={(fan2_speed * 255 + 0.5)|int}
	{% else %}
	M106 P2 S255
	{% endif %}
	UPDATE_DELAYED_GCODE ID=pause_fan_stop DURATION=10
	BOARD_FAN_OFF
	BOX_SET_CURRENT_BOX_IDLE_MODE
	
	MCLIB_SET_CURRENT STEPPER=stepper_z RESTORE=1
	CANCEL_PRINT_BASE

[gcode_macro FILE_CANCEL_PRINT]
gcode = 
	MOTOR_CANCEL_PRINT
	M84

[gcode_macro G29]
gcode = 
	{% if 'PROBE_COUNT' in params|upper %}
	{% set get_count = ('PROBE_COUNT' + params.PROBE_COUNT) %}
	{%else %}
	{% set get_count = "" %}
	{% endif %}
	
	{% set bed_temp = printer.custom_macro.default_bed_temp %}
	{% set extruder_temp = printer.custom_macro.g28_ext_temp %}
	{% set nozzle_clear_temp = printer.custom_macro.default_extruder_temp %}
	
	{% if 'BED_TEMP' in params|upper and params.BED_TEMP|default(0)|int >= printer.custom_macro.default_bed_temp %}
	{% set bed_temp = params.BED_TEMP %}
	{% endif %}
	
	{% if 'EXTRUDER_TEMP' in params|upper %}
	{% set nozzle_clear_temp = params.EXTRUDER_TEMP %}
	{% endif %}
	{% set enabled = printer["filament_switch_sensor filament_sensor"].enabled %}
	{% if enabled %}
	SET_FILAMENT_SENSOR SENSOR=filament_sensor ENABLE=0
	{% endif %}
	M104 S{extruder_temp}
	M140 S{bed_temp}
	BOARD_FAN_ON
	{% if "xy" not in printer.toolhead.homed_axes %}
	
	G28
	{% endif %}
	
	
	
	
	SET_G29_FLAG VALUE=1
	G28 Z
	BED_MESH_CLEAR
	NOZZLE_CLEAR
	M104 S{extruder_temp}
	M190 S{bed_temp}
	M109 S{extruder_temp}
	
	ZDOWN_SWITCH ENABLE=1
	G28 Z
	BED_MESH_CLEAR
	Z_TILT_ADJUST WAITTIME=5
	NEXT_HOMEZ_NACCU
	G28 Z
	SET_G29_FLAG VALUE=0
	
	M204 S5000
	SET_VELOCITY_LIMIT ACCEL_TO_DECEL=5000
	BED_MESH_CALIBRATE {get_count}
	G1 Z175 F1200
	BOX_MOVE_TO_SAFE_POS
	CXSAVE_CONFIG
	TURN_OFF_HEATERS
	{% if enabled %}
	SET_FILAMENT_SENSOR SENSOR=filament_sensor ENABLE=1
	{% endif %}

[gcode_macro BED_MANUAL_CAL_START]
gcode = 
	{action_respond_info("bed manual calibration start")}

[gcode_macro BED_MANUAL_CAL_END]
gcode = 
	{action_respond_info("bed manual calibration end")}

[gcode_macro BED_MANUAL_CAL]
gcode = 
	BED_MANUAL_CAL_START
	SET_G29_FLAG VALUE=1
	G28 Z
	BED_MESH_CLEAR
	NOZZLE_CLEAR
	NEXT_HOMEZ_NACCU
	G28 Z
	BED_MESH_CLEAR
	ZDOWN_SWITCH ENABLE=1
	G28 Z
	SET_G29_FLAG VALUE=0
	TURN_OFF_HEATERS
	BED_MANUAL_CAL_END

[gcode_macro BED_MESH_CALIBRATE_START_PRINT]
gcode = 
	{% if 'PROBE_COUNT' in params|upper %}
	{% set get_count = ('PROBE_COUNT' + params.PROBE_COUNT) %}
	{%else %}
	{% set get_count = "" %}
	{% endif %}
	
	{% if 'GCODE_FILE' in params|upper %}
	{% set get_gcode_file = ("GCODE_FILE='"+ params.GCODE_FILE + "'") %}
	{%else %}
	{% set get_gcode_file = "" %}
	{% endif %}
	{action_respond_info("get_gcode_file = %s" % (get_gcode_file))}
	
	{% set bed_temp = printer.custom_macro.default_bed_temp %}
	{% set extruder_temp = printer.custom_macro.g28_ext_temp %}
	{% set nozzle_clear_temp = printer.custom_macro.default_extruder_temp %}
	
	{% if 'BED_TEMP' in params|upper and params.BED_TEMP|default(0)|int >= printer.custom_macro.default_bed_temp %}
	{% set bed_temp = params.BED_TEMP %}
	{% endif %}
	
	{% if 'EXTRUDER_TEMP' in params|upper %}
	{% set nozzle_clear_temp = params.EXTRUDER_TEMP %}
	{% endif %}
	{% set enabled = printer["filament_switch_sensor filament_sensor"].enabled %}
	
	M106 S0
	M104 S{extruder_temp}
	M140 S{bed_temp}
	BOARD_FAN_ON
	{% if "z" not in printer.toolhead.homed_axes %}
	G28
	{% endif %}
	
	{% if enabled %}
	SET_FILAMENT_SENSOR SENSOR=filament_sensor ENABLE=0
	{% endif %}
	
	M104 S{extruder_temp}
	M190 S{bed_temp}
	M109 S{extruder_temp}
	
	{% if printer['gcode_macro START_PRINT'].prepare|int == 0 %}
	PRINT_PREPARED
	BED_MESH_CLEAR
	NOZZLE_CLEAR
	NEXT_HOMEZ_NACCU
	G28 Z
	{% endif %}
	
	M204 S5000
	SET_VELOCITY_LIMIT ACCEL_TO_DECEL=5000
	BED_MESH_CALIBRATE {get_count} {get_gcode_file}
	G0 Z10 F600
	CXSAVE_CONFIG
	{% if enabled %}
	SET_FILAMENT_SENSOR SENSOR=filament_sensor ENABLE=1
	{% endif %}

[gcode_macro WAIT_BED_STABLE_POS]
gcode = 
	{% if "xyz" not in printer.toolhead.homed_axes %}
	G28
	{% endif %}
	BOX_MOVE_TO_SAFE_POS
	G1 Z45 F1200

[gcode_macro TEST_HOME]
gcode = 
	{% for _ in range(100) %}
	G28
	{% endfor %}

[gcode_macro A_TriPress_STEP1]
gcode = 
	G28
	G1 Z25 F600

[gcode_macro A_TriPress_STEP2]
