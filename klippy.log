	{% set ch = ch[-1] if ch|length else '' %}
	{% set rfid_bits = {'A': 1, 'B': 2, 'C': 4, 'D': 8} %}
	{% set rfid_bit = rfid_bits[ch] if ch in rfid_bits else 0 %}
	{% endif %}
