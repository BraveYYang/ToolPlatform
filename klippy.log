[delayed_gcode ac_det_startup]
initial_duration = 0.5
gcode = 

[gcode_macro OBSERVABLE_AGING_TEST]
gcode = 
	{% set count = params.COUNT|default(3)|int %}
	{% set nozzles = params.NOZZLES|default("0,1,2,3") %}
	{% set nozzle_items = nozzles.split(",") %}
	{% set nozzle_count = nozzle_items|length %}
	{% set model = params.MODEL|default("CHANGE")|upper %}
	{% set nozzle_clear = params.CLEAR|default("False")|lower in ["true", "1", "yes", "on"] %}
	{% set accle = params.ACCLE|default(15000)|int %}
	{% set velocity = params.VELOCITY|default(800)|int %}
	{% set xy_count = params.XY_COUNT|default(1)|int %}
	{% set xy_margin = params.XY_MARGIN|default(10)|float %}
	{% set temp_heating = params.TEMP_VAL|default(70)|int %}
	{% set pp = printer['gcode_macro PRINTER_PARAM'] %}
	{% set z_max = pp['max_z_position']|float - xy_margin %}
	{% set xy_z_safe = 10 %}
	{% set xy_max_vel = printer.configfile.settings['printer'].max_velocity|float %}
	{% set pre_cut_x = printer.configfile.settings['cut'].pre_cut_pos_x %}
	{% set pre_cut_y = printer.configfile.settings['cut'].pre_cut_pos_y %}
	{% set cut_x = printer.configfile.settings['cut'].cut_pos_x %}
	{% set cut_y = printer.configfile.settings['cut'].cut_pos_y %}
	{% set nano_loops = params.NANO_LOOPS|default(1)|int %}
	M118 OBSERVABLE_AGING_TEST start model={model} count={count} nozzles={nozzles} nozzle_count={nozzle_count} clear={nozzle_clear} xy_count={xy_count} xy_margin={xy_margin} nano_loops={nano_loops}
	G28 Z
	BED_MESH_CLEAR
	{% if nozzle_clear %}
	{% for nozzle in nozzles.split(",") %}
	{% set nozzle_num = nozzle|trim|int %}
	M118 OBSERVABLE_AGING_TEST nozzle_clear nozzle_num={nozzle_num}
	T{nozzle_num}
	NOZZLE_CLEAR
	M106 S255
	M109 S35
	M106 S0
	M104 S0
	{% endfor %}
	{% endif %}
	
	ECS_XY_CALIBRATION SCAN=True
	{% for nozzle in nozzle_items %}
	{% set nozzle_num = nozzle|trim|int %}
	{% set nozzle_index = loop.index %}
	{% for round in range(count) %}
	{% set round_index = round + 1 %}
	M118 OBSERVABLE_AGING_TEST round_start model={model} nozzle_num={nozzle_num} nozzle_index={nozzle_index}/{nozzle_count} round={round_index}/{count}
	{% if model == "EDDY" %}
	M400
	ECS_XY_CALIBRATION NUM={nozzle_num} FILE=OBSERVABLE_AGING_TEST_EDDY
	{% elif model == "CHANGE" %}
	NOZZLE_REPLACE NOZZLE={nozzle_num} FORCE=1
	SET_VELOCITY_LIMIT ACCEL={accle} ACCEL_TO_DECEL={accle} VELOCITY={velocity}
	LOOP_XY_MOTION COUNT={xy_count} MARGIN={xy_margin} Z={xy_z_safe}
	ECS_XY_CALIBRATION NUM={nozzle_num} FILE=OBSERVABLE_AGING_TEST_CHANGE
	{% elif model == "CHANGE_HEATING" %}
	NOZZLE_REPLACE NOZZLE={nozzle_num} FORCE=1
	{% if round == 0 %}
	M118 OBSERVABLE_AGING_TEST CHANGE_HEATING: nozzle={nozzle_num} round={round_index}/{count} start heating
	M109 S{temp_heating}
	G1 Z{xy_z_safe} F600
	M400
	{% endif %}
	SET_VELOCITY_LIMIT ACCEL={accle} ACCEL_TO_DECEL={accle} VELOCITY={velocity}
	LOOP_XY_MOTION COUNT={xy_count} MARGIN={xy_margin} Z={xy_z_safe}
	ECS_XY_CALIBRATION NUM={nozzle_num} FILE=OBSERVABLE_AGING_TEST_CHANGE
	{% if round_index == count %}
	M118 OBSERVABLE_AGING_TEST CHANGE_HEATING: nozzle={nozzle_num} round={round_index}/{count} finish heating, cool down
	M104 S0
	{% endif %}
	{% elif model == "CUT" %}
	NOZZLE_REPLACE NOZZLE={nozzle_num}
	ECS_XY_CALIBRATION NUM={nozzle_num} FILE=OBSERVABLE_AGING_TEST_CUT
	M109 S220
	SET_LIMITS
	G90
	M118 OBSERVABLE_AGING_TEST CUT: nozzle={nozzle_num} round={round_index}/{count} start cut
	G1 X{pre_cut_x} Y{pre_cut_y} F6000
	M400
	SET_VELOCITY_LIMIT ACCEL=3000 ACCEL_TO_DECEL=3000
	MCLIB_SET_CURRENT STEPPER=stepper_x CURRENT=3 HOLDCURRENT=1.4
	MCLIB_SET_CURRENT STEPPER=stepper_y CURRENT=3 HOLDCURRENT=1.4
	G1 X{cut_x} Y{cut_y} F30000
	M400
	G1 X{pre_cut_x} Y{pre_cut_y} F6000
	M400
	M118 OBSERVABLE_AGING_TEST CUT: nozzle={nozzle_num} round={round_index}/{count} finish cut
	MCLIB_SET_CURRENT STEPPER=stepper_x RESTORE=1
	MCLIB_SET_CURRENT STEPPER=stepper_y RESTORE=1
	SET_VELOCITY_LIMIT ACCEL=5000 ACCEL_TO_DECEL=25000
	FORCE_MOVE STEPPER=extruder DISTANCE=-10 VELOCITY=10 ACCEL=1000
	BOX_NOZZLE_CLEAN
	ECS_XY_CALIBRATION NUM={nozzle_num} FILE=OBSERVABLE_AGING_TEST_CUT
	M118 OBSERVABLE_AGING_TEST CUT: nozzle={nozzle_num} round={round_index}/{count} start extrude material
	BOX_GO_TO_EXTRUDE_POS
	G92 E0
	M83
	G1 E30 F300
	M400
	M118 OBSERVABLE_AGING_TEST CUT: nozzle={nozzle_num} round={round_index}/{count} finish extrude material
	G92 E0
	BOX_NOZZLE_CLEAN
	G28 X Y
	{% elif model == "GOZERO" %}
	G28 X Y
	ECS_XY_CALIBRATION NUM={nozzle_num} FILE=OBSERVABLE_AGING_TEST_GOZERO
	{% elif model == "H7" %}
	SET_VELOCITY_LIMIT ACCEL={accle} ACCEL_TO_DECEL={accle} VELOCITY={velocity}
	LOOP_XY_MOTION COUNT={xy_count} MARGIN={xy_margin} Z={xy_z_safe} ARC=1
	ECS_XY_CALIBRATION NUM={nozzle_num} FILE=OBSERVABLE_AGING_TEST_H7
	{% elif model == "NANO_TEST" %}
	BOX_AGING_TEST LOOPS={nano_loops} CHANNELS={nozzle_num}
	{% endif %}
	M118 OBSERVABLE_AGING_TEST round_end model={model} nozzle_num={nozzle_num} nozzle_index={nozzle_index}/{nozzle_count} round={round_index}/{count}
	{% endfor %}
	{% if model == "CHANGE" %}
	M118 OBSERVABLE_AGING_TEST z_cycle model={model} nozzle_num={nozzle_num} nozzle_index={nozzle_index}/{nozzle_count} z_max={z_max} z_safe={xy_z_safe}
	G1 Z{z_max} F600
	G1 Z{xy_z_safe} F600
	{% endif %}
	BED_MESH_PROFILE LOAD=default
	{% endfor %}
	M118 OBSERVABLE_AGING_TEST finish model={model} count={count} nozzles={nozzles}

[gcode_macro OBSERVABLE_FULL_PROCESS_TEST]
gcode = 
	{% set count = params.COUNT|default(3)|int %}
	{% set nozzles = params.NOZZLES|default("0,1,2,3") %}
	{% set nozzle_items = nozzles.split(",") %}
	{% set nozzle_clear = params.CLEAR|default("False")|lower in ["true", "1", "yes", "on"] %}
	{% set xy_count = params.XY_COUNT|default(1)|int %}
	{% set xy_margin = params.XY_MARGIN|default(10)|float %}
	{% set xy_z_safe = 20 %}
	{% set xy_max_vel = printer.configfile.settings['printer'].max_velocity|float %}
	{% set xy_max_accel = printer.configfile.settings['printer'].max_accel|float %}
	{% set xy_max_accel_to_decel = printer.configfile.settings['printer'].max_accel_to_decel|float %}
	{% set nozzle_count = nozzle_items|length %}
	M118 OBSERVABLE_FULL_PROCESS_TEST start count={count} nozzles={nozzles} nozzle_count={nozzle_count} clear={nozzle_clear} xy_count={xy_count} xy_margin={xy_margin}
	G28 Z
	BED_MESH_CLEAR
	{% if nozzle_clear %}
	{% for nozzle in nozzles.split(",") %}
	{% set nozzle_num = nozzle|trim|int %}
	M118 OBSERVABLE_FULL_PROCESS_TEST nozzle_clear nozzle_num={nozzle_num}
	T{nozzle_num}
	NOZZLE_CLEAR
	M106 S255
	M109 S35
	M106 S0
	M104 S0
	{% endfor %}
	{% endif %}
	
	ECS_XY_CALIBRATION SCAN=True
	{% for nozzle in nozzle_items %}
	{% set nozzle_num = nozzle|trim|int %}
	{% set nozzle_index = loop.index %}
	{% set tnn = ["T1A", "T1B", "T1C", "T1D"][nozzle_num] %}
	
	M118 OBSERVABLE_FULL_PROCESS_TEST nozzle_start nozzle_num={nozzle_num} nozzle_index={nozzle_index}/{nozzle_count} tnn={tnn}
	NOZZLE_REPLACE NOZZLE={nozzle_num} FORCE=1
	{% for round in range(count) %}
	{% set round_index = round + 1 %}
	M118 OBSERVABLE_FULL_PROCESS_TEST motion_start nozzle_num={nozzle_num} nozzle_index={nozzle_index}/{nozzle_count} round={round_index}/{count}
	G90
	G1 Z{xy_z_safe} F600
	M400
	SET_VELOCITY_LIMIT ACCEL={xy_max_accel} ACCEL_TO_DECEL={xy_max_accel_to_decel} VELOCITY={xy_max_vel}
	LOOP_XY_MOTION COUNT={xy_count} MARGIN={xy_margin} Z={xy_z_safe} ARC=1
	{% endfor %}
	
	
	G28
	ECS_XY_CALIBRATION NUM={nozzle_num} FILE=OBSERVABLE_FULL_PROCESS_TEST
	
	
	M118 OBSERVABLE_FULL_PROCESS_TEST retract_start nozzle_num={nozzle_num} nozzle_index={nozzle_index}/{nozzle_count} tnn={tnn}
	BOX_RETRACT_MATERIAL TNN={tnn}
	
	
	ECS_XY_CALIBRATION NUM={nozzle_num} FILE=OBSERVABLE_FULL_PROCESS_TEST
	
	
	M118 OBSERVABLE_FULL_PROCESS_TEST feed_current_start nozzle_num={nozzle_num} nozzle_index={nozzle_index}/{nozzle_count} tnn={tnn}
	G28
	SAFE_EXTRUDE_CURRENT_INTERVAL ENABLE=1 FLAG=1
	BOX_FEED_MATERIAL TNN={tnn}
	
	G4 P2000
	SAFE_EXTRUDE_CURRENT_INTERVAL ENABLE=0
	
	NOZZLE_CLEAR
	
	M104 S0
	
	
	NOZZLE_RELEASE NOZZLE={nozzle_num}
	BED_MESH_PROFILE LOAD=default
	M118 OBSERVABLE_FULL_PROCESS_TEST nozzle_end nozzle_num={nozzle_num} nozzle_index={nozzle_index}/{nozzle_count}
	{% endfor %}
	M118 OBSERVABLE_FULL_PROCESS_TEST finish count={count} nozzles={nozzles}

[gcode_macro PROBE_AND_ECS_XY]
gcode = 
	{% if "xyz" not in printer.toolhead.homed_axes %}
	G28
	{% endif %}
	SET_LIMITS
	{% set x = params.X|float %}
	{% set y = params.Y|float %}
	{% set num = params.NUM|default(0)|int %}
	G1 X{x+5} Y{y+5} F6000
	PROBE PROBE_SPEED=5 SAMPLES=1 SAMPLES_RESULT=median
	G1 Z5 F300
	ECS_XY_RUN NUM={num} X={x} Y={y}

[gcode_macro ECS_XY_RUN]
gcode = 
	{% set z = printer["probe"].last_z_result|float %}
	{action_respond_info("probe z=%.4f, run ECS_XY_CALIBRATION" % z)}
	ECS_XY_CALIBRATION NUM={params.NUM} LINE_XYPOS={params.X},{params.Y} ZPOS={z}

[gcode_macro AUTO_PA]
gcode = 
	
	
	{% set nozzles = params.NOZZLES|default(params.NOZZLE|default("0,1,2,3")) %}
	{% set nozzle_items = nozzles.split(",") %}
	{% set nozzle_count = nozzle_items|length %}
	{% set temp = params.TEMP|default(220)|int %}
	{% set cool_temp = 140 %}
	{% set method = params.METHOD|default("step_response")|upper %}
	
	M118 AUTO_PA preheat nozzles={nozzles} temp={cool_temp}
	{% for nozzle in nozzle_items %}
	{% set nozzle_num = nozzle|trim|int %}
	M104 S{cool_temp} T{nozzle_num}
	{% endfor %}
	
	{% if "xyz" not in printer.toolhead.homed_axes %}
	G28
	{% endif %}
	
	M118 AUTO_PA start nozzles={nozzles} nozzle_count={nozzle_count} temp={temp} method={method}
	{% for nozzle in nozzle_items %}
	{% set nozzle_num = nozzle|trim|int %}
	{% set nozzle_index = loop.index %}
	M118 AUTO_PA nozzle_start nozzle={nozzle_num} nozzle_index={nozzle_index}/{nozzle_count} temp={temp}
	NOZZLE_REPLACE NOZZLE={nozzle_num}
	BOX_GO_TO_EXTRUDE_POS
	M400
	M109 S{temp}
	PA_CALIBRATE METHOD={method} NOZZLE={nozzle_num}
	BOX_NOZZLE_CLEAN
	
	
	M104 S0
	{% if loop.last %}
	NOZZLE_RELEASE NOZZLE={nozzle_num}
	{% endif %}
	M118 AUTO_PA nozzle_end nozzle={nozzle_num} nozzle_index={nozzle_index}/{nozzle_count} cool_temp={cool_temp}
	{% endfor %}
	M118 AUTO_PA finish nozzles={nozzles} cool_temp={cool_temp}

