QWidget {
    background-color: #111827;
    color: #e5e7eb;
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 14px;
}
QLabel { background-color: transparent; }
QMainWindow, QStackedWidget, QStatusBar { background-color: #111827; }
QFrame#topBar, QFrame#navigationPanel {
    background-color: #18212f;
    border: 1px solid #334155;
}
QLabel#platformTitle { font-size: 22px; font-weight: 700; color: #f8fafc; }
QLabel#pluginTitle { font-size: 18px; font-weight: 600; color: #f8fafc; }
QLabel#pluginDescription, QLabel#hintLabel, QLabel#infoLabel { color: #94a3b8; }
QLabel#strongLabel { color: #f1f5f9; font-weight: 600; }
QLabel#summaryBox, QLabel#statusHint {
    background-color: #18212f;
    color: #cbd5e1;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 7px 9px;
}
QCheckBox { spacing: 6px; background-color: transparent; }
QCheckBox#previewToggle { color: #60a5fa; font-weight: 600; }
QCheckBox:disabled { color: #64748b; }

QPushButton {
    background-color: #1f2937;
    color: #e5e7eb;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 6px 10px;
}
QPushButton:hover { background-color: #293548; border-color: #60a5fa; }
QPushButton:pressed, QPushButton:checked {
    background-color: #1e3a5f;
    border-color: #60a5fa;
    color: #dbeafe;
}
QPushButton:disabled {
    background-color: #1a2230;
    color: #64748b;
    border-color: #334155;
}
QPushButton#primary {
    background-color: #2563eb;
    color: #ffffff;
    border-color: #3b82f6;
    font-weight: 600;
}
QPushButton#primary:hover { background-color: #3b82f6; border-color: #60a5fa; }
QPushButton#primary:pressed, QPushButton#primary:checked { background-color: #1d4ed8; }
QPushButton#primary:disabled { background-color: #263b63; color: #8192ad; border-color: #34496c; }
QPushButton#danger {
    background-color: #b91c1c;
    color: #ffffff;
    border-color: #dc2626;
    font-weight: 600;
}
QPushButton#danger:hover { background-color: #dc2626; border-color: #f87171; }
QPushButton#danger:pressed, QPushButton#danger:checked { background-color: #991b1b; }
QPushButton#danger:disabled { background-color: #412529; color: #87666b; border-color: #593238; }

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox,
QListWidget, QTableWidget, QTextEdit, QPlainTextEdit {
    background-color: #1f2937;
    color: #e5e7eb;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 5px 7px;
    selection-background-color: #1d4ed8;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QListWidget:focus, QTableWidget:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #60a5fa;
}
QLineEdit[readOnly="true"], QTextEdit[readOnly="true"], QPlainTextEdit[readOnly="true"] {
    background-color: #18212f;
    color: #aebbd0;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled,
QListWidget:disabled, QTableWidget:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #1a2230;
    color: #64748b;
    border-color: #334155;
}
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background-color: #1f2937;
    color: #e5e7eb;
    border: 1px solid #475569;
    selection-background-color: #1d4ed8;
    selection-color: #ffffff;
    outline: none;
}
QListWidget::item, QTableWidget::item { padding: 4px; }
QListWidget::item:alternate, QTableWidget::item:alternate { background-color: #18212f; }
QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #1d4ed8;
    color: #ffffff;
}
QTableWidget { gridline-color: #334155; }
QTreeWidget {
    background-color: #18212f;
    color: #e5e7eb;
    border: none;
    outline: none;
}
QTreeWidget::item { min-height: 34px; padding: 3px 7px; border-radius: 5px; }
QTreeWidget::item:selected { background-color: #1d4ed8; color: #ffffff; }
QTreeWidget::item:hover:!selected { background-color: #263449; }
QHeaderView::section {
    background-color: #263449;
    color: #e2e8f0;
    border: none;
    border-right: 1px solid #3b4b61;
    border-bottom: 1px solid #3b4b61;
    padding: 5px;
    font-weight: 600;
}

QGroupBox {
    background-color: #18212f;
    color: #e5e7eb;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-top: 10px;
    padding: 9px 7px 7px 7px;
    font-weight: 600;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; }
QGroupBox:disabled { color: #64748b; border-color: #293548; }

QTabWidget::pane {
    background-color: #18212f;
    border: 1px solid #334155;
    border-radius: 6px;
    top: -1px;
}
QTabBar::tab {
    background-color: #1f2937;
    color: #94a3b8;
    border: 1px solid #334155;
    padding: 7px 12px;
}
QTabBar::tab:selected { background-color: #18212f; color: #bfdbfe; border-bottom-color: #18212f; }
QTabBar::tab:hover:!selected { background-color: #263449; }
QTabBar::tab:disabled { color: #64748b; }

QProgressBar {
    background-color: #1f2937;
    color: #e5e7eb;
    border: 1px solid #475569;
    border-radius: 5px;
    text-align: center;
    min-height: 18px;
}
QProgressBar::chunk { background-color: #3b82f6; border-radius: 4px; }
QProgressBar:disabled { background-color: #1a2230; color: #64748b; }

QScrollArea, QScrollArea QWidget#qt_scrollarea_viewport {
    background-color: #111827;
    border-color: #334155;
}
QScrollBar:vertical, QScrollBar:horizontal { background-color: #18212f; border: none; margin: 0; }
QScrollBar:vertical { width: 12px; }
QScrollBar:horizontal { height: 12px; }
QScrollBar::handle { background-color: #475569; border-radius: 5px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background-color: #64748b; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QLabel#resultBox, QPlainTextEdit#resultBox {
    border-radius: 6px;
    padding: 7px 9px;
    font-weight: 600;
}
QLabel#resultBox[resultState="neutral"], QPlainTextEdit#resultBox[resultState="neutral"] {
    background-color: #1f2937;
    color: #cbd5e1;
    border: 1px solid #475569;
}
QLabel#resultBox[resultState="success"], QPlainTextEdit#resultBox[resultState="success"] {
    background-color: #123524;
    color: #bbf7d0;
    border: 1px solid #2f855a;
}
QLabel#resultBox[resultState="error"], QPlainTextEdit#resultBox[resultState="error"] {
    background-color: #401c22;
    color: #fecaca;
    border: 1px solid #b94a57;
}

QMenu { background-color: #1f2937; color: #e5e7eb; border: 1px solid #475569; }
QMenu::item:selected { background-color: #1d4ed8; color: #ffffff; }
QToolTip { background-color: #e2e8f0; color: #111827; border: 1px solid #94a3b8; padding: 4px; }
QStatusBar { border-top: 1px solid #334155; color: #94a3b8; }
QSplitter::handle { background-color: #334155; width: 1px; }

/* 顶部工具导航 */
QFrame#toolNavigationBar {
    background-color: #18212f;
    border: none;
    border-bottom: 1px solid #334155;
}
QFrame#pluginInfoBar {
    background-color: #18212f;
    border: 1px solid #334155;
    border-radius: 6px;
}
QTabBar#toolTabs { background-color: transparent; }
QTabBar#toolTabs::tab {
    background-color: transparent;
    color: #94a3b8;
    border: 1px solid transparent;
    border-bottom: 3px solid transparent;
    border-radius: 6px 6px 0 0;
    min-width: 116px;
    min-height: 28px;
    padding: 6px 16px;
    margin-right: 3px;
}
QTabBar#toolTabs::tab:hover:!selected {
    background-color: #263449;
    color: #dbeafe;
    border-color: #475569;
    border-bottom-color: #60a5fa;
}
QTabBar#toolTabs::tab:selected {
    background-color: #1f2937;
    color: #bfdbfe;
    border-color: #475569;
    border-bottom-color: #60a5fa;
    font-weight: 600;
}
QTabBar#toolTabs QToolButton {
    background-color: #1f2937;
    color: #cbd5e1;
    border: 1px solid #475569;
    border-radius: 5px;
    margin: 4px 2px;
    padding: 2px;
}
QTabBar#toolTabs QToolButton:hover {
    background-color: #1e3a5f;
    border-color: #60a5fa;
}
QSplitter#nozzleMainSplitter::handle:horizontal,
QSplitter#sshHorizontalSplitter::handle:horizontal {
    background-color: #334155;
    width: 6px;
}
QSplitter#sshVerticalSplitter::handle:vertical {
    background-color: #334155;
    height: 6px;
}
QSplitter#nozzleMainSplitter::handle:hover,
QSplitter#sshHorizontalSplitter::handle:hover,
QSplitter#sshVerticalSplitter::handle:hover { background-color: #60a5fa; }

/* 紧凑布局覆盖：与工业主题切换时保持尺寸一致 */
QWidget { font-size: 12px; }
QLabel#platformTitle { font-size: 18px; }
QLabel#pluginTitle { font-size: 15px; }
QPushButton { border-radius: 4px; padding: 4px 8px; min-height: 18px; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox,
QListWidget, QTableWidget, QTextEdit, QPlainTextEdit { border-radius: 4px; padding: 3px 5px; }
QComboBox::drop-down { width: 18px; }
QListWidget::item, QTableWidget::item { padding: 2px 4px; }
QTreeWidget::item { min-height: 24px; padding: 2px 5px; }
QHeaderView::section { padding: 3px 4px; }
QGroupBox { border-radius: 4px; margin-top: 8px; padding: 6px 5px 5px 5px; }
QGroupBox::title { left: 7px; padding: 0 4px; }
QTabWidget::pane { border-radius: 4px; }
QTabBar::tab { padding: 4px 8px; min-height: 18px; }
QProgressBar { min-height: 14px; max-height: 18px; border-radius: 3px; }
QScrollBar:vertical { width: 10px; }
QScrollBar:horizontal { height: 10px; }
QLabel#summaryBox, QLabel#statusHint,
QLabel#resultBox, QPlainTextEdit#resultBox { border-radius: 4px; padding: 4px 6px; }
QStatusBar { min-height: 18px; }
QFrame#pluginInfoBar { border-radius: 4px; }
QTabBar#toolTabs::tab { min-width: 92px; min-height: 18px; padding: 3px 10px; border-bottom-width: 2px; }
QTabBar#toolTabs QToolButton { margin: 2px 1px; padding: 1px; }
QSplitter#nozzleMainSplitter::handle:horizontal,
QSplitter#sshHorizontalSplitter::handle:horizontal { width: 4px; }
QSplitter#sshVerticalSplitter::handle:vertical { height: 4px; }

/* 批量识别横向三栏与底部结果表分隔条 */
QSplitter#nozzleBatchHorizontalSplitter::handle:horizontal {
    background-color: #334155;
    width: 4px;
}
QSplitter#nozzleBatchVerticalSplitter::handle:vertical {
    background-color: #334155;
    height: 4px;
}
QSplitter#nozzleBatchHorizontalSplitter::handle:hover,
QSplitter#nozzleBatchVerticalSplitter::handle:hover { background-color: #60a5fa; }
